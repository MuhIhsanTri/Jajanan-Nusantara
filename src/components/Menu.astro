const menuItems = [
  {
    id: 'batagor-spesial',
    name: 'Batagor Spesial Ikan Tenggiri',
    category: 'batagor-siomay',
    price: 'Rp 22.000',
    originalPrice: 'Rp 25.000',
    image: 'https://images.unsplash.com/photo-1541696432-82c6da8ce7bf?auto=format&fit=crop&w=800&q=80',
    description: 'Tahu bakso ikan tenggiri goreng renyah dan pangsit krispi, disiram bumbu kacang kental khas nusantara, kecap manis, dan perasan jeruk limau segar.',
    badge: 'Paling Diminati',
    portion: '5 Pcs / Porsi',
  },
  {
    id: 'siomay-bandung',
    name: 'Siomay Bandung Komplit Saus Kacang',
    category: 'batagor-siomay',
    price: 'Rp 22.000',
    originalPrice: 'Rp 25.000',
    image: 'https://images.unsplash.com/photo-1498654896293-37aacf113fd9?auto=format&fit=crop&w=800&q=80',
    description: 'Siomay kukus murni ikan tenggiri, tahu putih, kol gulung, kentang, dan telur rebus dengan siraman saus kacang medok beraroma harum.',
    badge: 'Favorit Pelanggan',
    portion: '1 Piring Komplit',
  },
  {
    id: 'batagor-kuah',
    name: 'Batagor Kuah Kaldu Sapi Gurih',
    category: 'batagor-siomay',
    price: 'Rp 24.000',
    image: 'https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=800&q=80',
    description: 'Sensasi batagor disajikan hangat dengan kuah kaldu sapi bening kaya rempah, daun bawang iris, bawang goreng renyah, dan sambal cabai rawit pedas segar.',
    badge: 'Sajian Hangat',
