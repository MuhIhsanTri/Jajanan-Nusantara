    category: 'martabak-manis',
    price: 'Rp 55.000',
    image: 'https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=800&q=80',
    description: 'Adonan red velvet lembut khas dengan olesan cream cheese gurih dan taburan remah biskuit oreo renyah.',
    badge: 'Menu Spesial',
