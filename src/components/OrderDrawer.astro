---
// src/components/OrderDrawer.astro
const waNumber = '6281234567890';
---

<!-- Floating Cart Bar (appears when items > 0) -->
<div 
  id="cart-floating-bar" 
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 hidden max-w-md w-[calc(100%-2rem)] bg-brand-dark text-white rounded-xl shadow-2xl border border-gray-700 p-3 items-center justify-between transition-all"
  role="region"
  aria-label="Ringkasan Keranjang Pesanan"
>
  <div class="flex items-center gap-3 pl-2">
    <div class="w-10 h-10 rounded-lg bg-brand-primary flex items-center justify-center font-bold text-base shrink-0" aria-hidden="true">
      🛒
    </div>
    <div>
      <div class="text-xs text-gray-300 font-medium">
        <span id="floating-cart-count">0</span> Menu Dipilih
      </div>
      <div class="text-sm font-extrabold text-white" id="floating-cart-total">
        Rp 0
      </div>
    </div>
  </div>

  <button
    type="button"
    id="open-cart-btn"
    class="min-h-[44px] px-5 py-2.5 rounded-lg bg-brand-primary hover:bg-brand-primary-dark text-white font-bold text-xs sm:text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
  >
    Buka Pesanan
  </button>
</div>

<!-- Backdrop Overlay -->
<div 
  id="cart-backdrop" 
  class="fixed inset-0 bg-black/60 z-50 hidden transition-opacity"
  aria-hidden="true"
></div>

<!-- Slide-over Drawer Dialog (R-26, R-32, R-39 compliant) -->
<div
  id="cart-drawer"
  class="fixed top-0 right-0 bottom-0 z-50 w-full max-w-md bg-white shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out border-l border-[#EADFCF]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drawer-title"
  tabindex="-1"
>
  <!-- Drawer Header -->
  <div class="p-5 border-b border-[#EADFCF] flex items-center justify-between bg-[#FDFBF7]">
    <div class="flex items-center gap-2.5">
      <span class="text-xl" aria-hidden="true">📋</span>
      <h2 id="drawer-title" class="text-lg font-bold text-brand-dark">
        Daftar Pesanan Anda
      </h2>
    </div>
    
    <button
      type="button"
      id="close-cart-btn"
      class="min-w-[44px] min-h-[44px] p-2 rounded-lg text-brand-dark hover:bg-[#F2E8D8] transition-colors flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
      aria-label="Tutup Keranjang Pesanan"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Body (Items list + Options) -->
  <div class="flex-1 overflow-y-auto p-5 space-y-6">
    
    <!-- Empty State -->
    <div id="cart-empty-state" class="py-12 text-center">
      <div class="text-4xl mb-3" aria-hidden="true">🍽️</div>
      <p class="text-base font-bold text-brand-dark mb-1">Keranjang masih kosong</p>
      <p class="text-xs text-brand-dark/70 max-w-xs mx-auto">
        Silakan pilih menu favorit Anda dari katalog dan klik tombol "+ Keranjang".
      </p>
    </div>

    <!-- Filled Items Container -->
    <div id="cart-items-container" class="space-y-3 hidden">
      <!-- Injected via JavaScript -->
    </div>

    <!-- Customer Details Form (Only when items > 0) -->
    <form id="cart-order-form" class="space-y-4 pt-4 border-t border-[#EADFCF] hidden">
      <div>
        <label for="customer-name" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">
          Nama Lengkap Pemesan <span class="text-brand-primary">*</span>
        </label>
        <input
          type="text"
          id="customer-name"
          name="name"
          placeholder="Contoh: Budi Santoso"
          required
          class="w-full min-h-[44px] px-3.5 py-2.5 rounded-lg border border-[#D5C7B3] text-sm text-brand-dark focus:border-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary bg-[#FDFBF7]"
        />
      </div>

      <div>
        <label for="order-type" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">
          Pilihan Layanan <span class="text-brand-primary">*</span>
        </label>
        <select
          id="order-type"
          name="orderType"
          class="w-full min-h-[44px] px-3 py-2.5 rounded-lg border border-[#D5C7B3] text-sm text-brand-dark focus:border-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary bg-[#FDFBF7]"
        >
          <option value="Bungkus / Takeaway">Bungkus / Bawa Pulang (Takeaway)</option>
          <option value="Makan di Tempat (Dine-in)">Makan di Tempat (Dine-in di Gerai)</option>
          <option value="Pesan Antar (Kurir/Ojol)">Pesan Antar (Kurir Ojek Online)</option>
        </select>
      </div>

      <div>
        <label for="order-notes" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">
          Catatan Tambahan (Opsional)
        </label>
        <textarea
          id="order-notes"
          name="notes"
          rows="2"
          placeholder="Contoh: Bumbu kacang dipisah, sambal sedikit, martabak potong 12"
          class="w-full px-3.5 py-2 rounded-lg border border-[#D5C7B3] text-sm text-brand-dark focus:border-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary bg-[#FDFBF7]"
        ></textarea>
      </div>
    </form>

  </div>

  <!-- Drawer Footer (Total + Send to WhatsApp) -->
  <div class="p-5 border-t border-[#EADFCF] bg-[#FDFBF7] space-y-3">
    <div class="flex items-baseline justify-between text-brand-dark">
      <span class="text-sm font-semibold">Total Estimasi:</span>
      <span class="text-xl font-extrabold text-brand-primary" id="drawer-total-price">
        Rp 0
      </span>
    </div>

    <button
      type="button"
      id="submit-order-whatsapp-btn"
      class="w-full min-h-[48px] flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
      disabled
    >
      <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.449.741.964 1.2.662.59 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.306A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
      </svg>
      <span>Kirim Pesanan Lengkap via WhatsApp</span>
    </button>
  </div>
</div>

<script define:vars={{ waNumber }}>
  // Cart State Management
  interface CartItem {
    id: string;
    name: string;
    price: number;
    priceFormatted: string;
    qty: number;
  }

  let cart: Record<string, CartItem> = {};

  const floatingBar = document.getElementById('cart-floating-bar');
  const floatingCount = document.getElementById('floating-cart-count');
  const floatingTotal = document.getElementById('floating-cart-total');
  
  const drawer = document.getElementById('cart-drawer');
  const backdrop = document.getElementById('cart-backdrop');
  const openBtn = document.getElementById('open-cart-btn');
  const closeBtn = document.getElementById('close-cart-btn');
  
  const itemsContainer = document.getElementById('cart-items-container');
  const emptyState = document.getElementById('cart-empty-state');
  const orderForm = document.getElementById('cart-order-form');
  const drawerTotal = document.getElementById('drawer-total-price');
  const submitBtn = document.getElementById('submit-order-whatsapp-btn');
  const nameInput = document.getElementById('customer-name');
  const orderTypeSelect = document.getElementById('order-type');
  const notesTextarea = document.getElementById('order-notes');

  function parsePrice(priceStr) {
    // e.g. "Rp 22.000" -> 22000
    return parseInt(priceStr.replace(/[^0-9]/g, ''), 10) || 0;
  }

  function formatRupiah(num) {
    return 'Rp ' + num.toLocaleString('id-ID');
  }

  function updateCartUI() {
    const items = Object.values(cart);
    const totalQty = items.reduce((sum, item) => sum + item.qty, 0);
    const totalPrice = items.reduce((sum, item) => sum + (item.price * item.qty), 0);

    // Update floating bar
    if (floatingCount && floatingTotal && floatingBar) {
      floatingCount.textContent = String(totalQty);
      floatingTotal.textContent = formatRupiah(totalPrice);
      if (totalQty > 0) {
        floatingBar.classList.remove('hidden');
        floatingBar.classList.add('flex');
      } else {
        floatingBar.classList.add('hidden');
        floatingBar.classList.remove('flex');
      }
    }

    // Update Drawer
    if (drawerTotal) {
      drawerTotal.textContent = formatRupiah(totalPrice);
    }

    if (totalQty === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (itemsContainer) itemsContainer.classList.add('hidden');
      if (orderForm) orderForm.classList.add('hidden');
      if (submitBtn) submitBtn.setAttribute('disabled', 'true');
    } else {
      if (emptyState) emptyState.classList.add('hidden');
      if (itemsContainer) itemsContainer.classList.remove('hidden');
      if (orderForm) orderForm.classList.remove('hidden');
      if (submitBtn) submitBtn.removeAttribute('disabled');

      // Render Item rows
      if (itemsContainer) {
        itemsContainer.innerHTML = items.map((item) => `
          <div class="flex items-center justify-between p-3 rounded-lg bg-[#FDFBF7] border border-[#EADFCF]">
            <div class="flex-1 pr-3">
              <h4 class="text-sm font-bold text-brand-dark leading-snug">${item.name}</h4>
              <span class="text-xs font-semibold text-brand-primary">${formatRupiah(item.price)} / porsi</span>
            </div>
            
            <div class="flex items-center gap-2">
              <button
                type="button"
                data-action="dec"
                data-id="${item.id}"
                class="cart-qty-btn min-w-[32px] min-h-[32px] rounded border border-[#D5C7B3] bg-white hover:bg-[#F2E8D8] text-brand-dark font-bold text-sm flex items-center justify-center transition-colors"
                aria-label="Kurangi ${item.name}"
              >
                -
              </button>
              <span class="w-6 text-center text-sm font-bold text-brand-dark">${item.qty}</span>
              <button
                type="button"
                data-action="inc"
                data-id="${item.id}"
                class="cart-qty-btn min-w-[32px] min-h-[32px] rounded border border-[#D5C7B3] bg-white hover:bg-[#F2E8D8] text-brand-dark font-bold text-sm flex items-center justify-center transition-colors"
                aria-label="Tambah ${item.name}"
              >
                +
              </button>
            </div>
          </div>
        `).join('');

        // Attach quantity buttons
        const qtyButtons = itemsContainer.querySelectorAll('.cart-qty-btn');
        qtyButtons.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget;
            const action = target.getAttribute('data-action');
            const id = target.getAttribute('data-id');
            if (id && cart[id]) {
              if (action === 'inc') {
                cart[id].qty += 1;
              } else if (action === 'dec') {
                cart[id].qty -= 1;
                if (cart[id].qty <= 0) {
                  delete cart[id];
                }
              }
              updateCartUI();
            }
          });
        });
      }
    }
  }

  function openDrawer() {
    if (drawer && backdrop) {
      backdrop.classList.remove('hidden');
      drawer.classList.remove('translate-x-full');
      drawer.focus();
    }
  }

  function closeDrawer() {
    if (drawer && backdrop) {
      drawer.classList.add('translate-x-full');
      backdrop.classList.add('hidden');
    }
  }

  // Open & Close Listeners
  if (openBtn) openBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (backdrop) backdrop.addEventListener('click', closeDrawer);

  // Keyboard accessibility: Escape closes drawer (R-32)
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.classList.contains('translate-x-full')) {
      closeDrawer();
    }
  });

  // Global Add to Cart listener
  window.addEventListener('add-to-cart', (e) => {
    const detail = e.detail;
    if (detail && detail.id) {
      if (cart[detail.id]) {
        cart[detail.id].qty += 1;
      } else {
        cart[detail.id] = {
          id: detail.id,
          name: detail.name,
          price: parsePrice(detail.price),
          priceFormatted: detail.price,
          qty: 1,
        };
      }
      updateCartUI();
      openDrawer();
    }
  });

  // Submit Order to WhatsApp
  if (submitBtn) {
    submitBtn.addEventListener('click', () => {
      const items = Object.values(cart);
      if (items.length === 0) return;

      const customerName = (nameInput && nameInput.value.trim()) || 'Pelanggan';
      const orderType = (orderTypeSelect && orderTypeSelect.value) || 'Bungkus / Takeaway';
      const notes = (notesTextarea && notesTextarea.value.trim()) || '-';
      const totalPrice = items.reduce((sum, item) => sum + (item.price * item.qty), 0);

      const itemsText = items
        .map((i) => `• ${i.qty}x ${i.name} (${formatRupiah(i.price * i.qty)})`)
        .join('\n');

      const message = 
`Halo Jajanan Nusantara! Saya ingin memesan hidangan dari website:

*Nama:* ${customerName}
*Layanan:* ${orderType}

*Detail Menu:*
${itemsText}

*Catatan:* ${notes}
*Total Pembayaran:* ${formatRupiah(totalPrice)}

Mohon konfirmasi ketersediaan pesanan saya. Terima kasih!`;

      const encoded = encodeURIComponent(message);
      const url = `https://wa.me/${waNumber}?text=${encoded}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>
