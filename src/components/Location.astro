---
// src/components/Location.astro
const schedule = [
  { day: 'Senin - Kamis', hours: '10:00 - 22:00 WIB', note: 'Makan di tempat & bungkus' },
  { day: 'Jumat', hours: '13:00 - 22:30 WIB', note: 'Buka setelah ibadah Sholat Jumat' },
  { day: 'Sabtu - Minggu', hours: '09:00 - 23:00 WIB', note: 'Buka lebih awal di akhir pekan' },
];

const contactChannels = [
  { title: 'Alamat Gerai', value: 'Jl. Kuliner Nusantara Raya No. 88, Kebayoran Baru, Jakarta Selatan' },
  { title: 'WhatsApp Pemesanan', value: '+62 812-3456-7890' },
  { title: 'Layanan Pembelian', value: 'Makan di tempat, Takeaway, dan Pesan Antar via WhatsApp' },
];
---

<section id="lokasi" class="py-16 md:py-24 bg-[#FDFBF7] border-b border-[#EADFCF]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary bg-[#FCEEE8] border border-orange-200 px-3 py-1.5 rounded inline-block mb-3">
        Lokasi & Operasional
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight mb-4">
        Kunjungi Gerai Kami
      </h2>
      <p class="text-brand-dark/80 text-base sm:text-lg">
        Tersedia area duduk bersih, tempat parkir yang memadai, serta dapur terbuka yang higienis.
      </p>
    </div>

    <!-- Main Grid: Info Cards + Map Embed -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Column: Operating Hours & Quick Info -->
      <div class="lg:col-span-5 flex flex-col justify-between gap-6">
        
        <!-- Operating Hours Card -->
        <div class="bg-white rounded-xl p-6 sm:p-7 border border-[#EADFCF]">
          <div class="flex items-center justify-between pb-4 border-b border-[#EADFCF] mb-5">
            <span class="font-bold text-sm text-emerald-800 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
              Gerai Buka Hari Ini
            </span>
            <span class="text-xs text-brand-dark/60 font-medium">
              Dimasak Segar
            </span>
          </div>

          <h3 class="text-base font-bold text-brand-dark mb-3">
            Jadwal Jam Buka
          </h3>

          <div class="space-y-3">
            {schedule.map((item) => (
              <div class="p-3 rounded-lg bg-[#FDFBF7] border border-[#EADFCF] flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <div>
                  <span class="font-bold text-brand-dark text-sm block">{item.day}</span>
                  <span class="text-xs text-brand-dark/70">{item.note}</span>
                </div>
                <span class="text-xs sm:text-sm font-extrabold text-brand-primary sm:text-right">
                  {item.hours}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Contact & Address Card -->
        <div class="bg-white rounded-xl p-6 sm:p-7 border border-[#EADFCF]">
          <h3 class="text-base font-bold text-brand-dark mb-4">
            Informasi Alamat & Kontak
          </h3>

          <div class="space-y-4">
            {contactChannels.map((item) => (
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-brand-dark/60">{item.title}</h4>
                <p class="text-sm font-semibold text-brand-dark mt-0.5">{item.value}</p>
              </div>
            ))}
          </div>

          <!-- Action Buttons with 44px tap target (R-03) -->
          <div class="pt-5 mt-5 border-t border-[#EADFCF] flex flex-col sm:flex-row gap-3">
            <a
              href="https://maps.google.com/?q=Jakarta+Selatan+Kuliner"
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 min-h-[44px] flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg bg-brand-dark hover:bg-black text-white font-bold text-xs sm:text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
            >
              <span>Petunjuk Google Maps</span>
            </a>

            <a
              href="https://wa.me/6281234567890?text=Halo%20Jajanan%20Nusantara,%20saya%20ingin%20tanya%20rute%20lokasi%20atau%20pesan%20takeaway."
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 min-h-[44px] flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg bg-brand-primary hover:bg-brand-primary-dark text-white font-bold text-xs sm:text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
            >
              <span>Tanya via WhatsApp</span>
            </a>
          </div>

        </div>

      </div>

      <!-- Right Column: Map Embed with explicit dimensions (R-40) -->
      <div class="lg:col-span-7">
        <div class="h-full min-h-[400px] rounded-xl overflow-hidden border border-[#EADFCF] bg-white flex flex-col">
          
          <div class="bg-[#FDFBF7] px-5 py-3 border-b border-[#EADFCF] flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-brand-primary"></span>
              <span class="font-bold text-sm text-brand-dark">Peta Gerai Pusat Jajanan Nusantara</span>
            </div>
            <span class="text-xs text-brand-dark/70 font-medium">Area Kebayoran Baru</span>
          </div>

          <div class="relative w-full flex-1 min-h-[350px]">
            <iframe
              title="Peta Lokasi Gerai Jajanan Nusantara"
              width="600"
              height="450"
              class="w-full h-full min-h-[350px] border-0"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.2974902096773!2d106.80005727475066!3d-6.224449893763695!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f14cf3e4fb2d%3A0x6b4eb547dcf6c858!2sSenopati%2C%20Kby.%20Baru%2C%20Kota%20Jakarta%20Selatan!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <div class="bg-white px-5 py-2.5 border-t border-[#EADFCF] text-xs text-brand-dark/75 flex justify-between">
            <span>Area parkir motor dan mobil tersedia</span>
            <span class="font-semibold text-brand-dark">Buka Setiap Hari</span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
