---
// src/components/Footer.astro
const quickLinks = [
  { name: 'Beranda', href: '#beranda' },
  { name: 'Tentang Kami', href: '#tentang' },
  { name: 'Menu Andalan', href: '#menu' },
  { name: 'Ulasan Pelanggan', href: '#ulasan' },
  { name: 'Lokasi & Jam Buka', href: '#lokasi' },
];

const menuCategories = [
  { name: 'Batagor Ikan Tenggiri', href: '#menu' },
  { name: 'Siomay Bandung Komplit', href: '#menu' },
  { name: 'Martabak Manis Wijsman', href: '#menu' },
  { name: 'Martabak Telur Daging Sapi', href: '#menu' },
  { name: 'Minuman Cendol Gula Aren', href: '#menu' },
];

const waUrl = 'https://wa.me/6281234567890?text=Halo%20Jajanan%20Nusantara!%20Saya%20ingin%20pesan%20makanan.';
---

<footer class="bg-brand-dark text-white pt-14 pb-10 border-t-4 border-brand-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Row: Brand & Links Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 pb-10 border-b border-gray-700/80">
      
      <!-- Brand Profile -->
      <div class="lg:col-span-5 flex flex-col items-start">
        <a href="#beranda" class="flex items-center gap-3.5 mb-4 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded p-1">
          <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-brand-secondary shrink-0 bg-white">
            <img 
              src="/images/logo.jpg" 
              alt="Logo Jajanan Nusantara" 
              width="48"
              height="48"
              class="w-full h-full object-cover" 
            />
          </div>
          <div>
            <span class="text-xl font-extrabold tracking-tight text-white block">
              Jajanan Nusantara
            </span>
            <span class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">
              Batagor • Siomay • Martabak
            </span>
          </div>
        </a>

        <p class="text-sm text-gray-300 leading-relaxed max-w-sm mb-6">
          Sensasi jajanan kaki lima otentik dengan standar kebersihan dan kualitas bahan terbaik. Dibuat dari daging ikan tenggiri asli dan bumbu kacang sangrai tradisi nusantara.
        </p>

        <!-- Social Icons meeting min 44px tap target (R-03, R-39) -->
        <div class="flex items-center gap-3">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="min-w-[44px] min-h-[44px] rounded-lg bg-white/10 hover:bg-brand-primary flex items-center justify-center transition-colors text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
            aria-label="Instagram Resmi Jajanan Nusantara"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noopener noreferrer"
            class="min-w-[44px] min-h-[44px] rounded-lg bg-white/10 hover:bg-brand-primary flex items-center justify-center transition-colors text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
            aria-label="TikTok Resmi Jajanan Nusantara"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .57.04.84.12V9.32a6.37 6.37 0 0 0-.84-.06 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.71a8.21 8.21 0 0 0 4.77 1.52V6.78a4.84 4.84 0 0 1-1-.09z"/>
            </svg>
          </a>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="min-w-[44px] min-h-[44px] rounded-lg bg-white/10 hover:bg-emerald-600 flex items-center justify-center transition-colors text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
            aria-label="Kontak Pemesanan WhatsApp"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.449.741.964 1.2.662.59 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.306A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="lg:col-span-2">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-secondary mb-4">Navigasi</h3>
        <ul class="space-y-2.5 text-sm text-gray-300">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-brand-secondary transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-secondary">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Items (All real anchor links) -->
      <div class="lg:col-span-2">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-secondary mb-4">Kategori Menu</h3>
        <ul class="space-y-2.5 text-sm text-gray-300">
          {menuCategories.map((item) => (
            <li>
              <a href={item.href} class="hover:text-brand-secondary transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-secondary">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact details -->
      <div class="lg:col-span-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-secondary mb-4">Kontak & Lokasi</h3>
        <div class="space-y-2.5 text-xs sm:text-sm text-gray-300">
          <p>
            <span class="font-semibold text-white">Alamat:</span><br />
            Jl. Kuliner Nusantara Raya No. 88, Kebayoran Baru, Jakarta Selatan
          </p>
          <p>
            <span class="font-semibold text-white">WhatsApp:</span><br />
            <a href={waUrl} class="text-brand-secondary font-bold hover:underline">
              +62 812-3456-7890
            </a>
          </p>
          <p>
            <span class="font-semibold text-white">Jam Operasional:</span><br />
            Setiap Hari: 10:00 - 22:00 WIB
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>
        © 2026 Jajanan Nusantara. Seluruh hak cipta dilindungi.
      </p>
      <p>
        Kuliner Kaki Lima Kualitas Bintang Lima.
      </p>
    </div>

  </div>
</footer>
