---
// src/components/WhatsAppFloat.astro
const waNumber = '6281234567890';
const waMessage = encodeURIComponent('Halo Jajanan Nusantara! Saya ingin memesan menu streetfood via WhatsApp.');
const waUrl = `https://wa.me/${waNumber}?text=${waMessage}`;
---

<!-- Floating WhatsApp Button (R-03, R-32, R-39 compliant) -->
<aside class="fixed bottom-6 right-6 z-40 group flex items-center" aria-label="Akses Pemesanan Cepat">
  <div class="hidden md:flex items-center mr-3 px-3 py-1.5 bg-brand-dark text-white text-xs font-semibold rounded-lg shadow-md border border-gray-700 pointer-events-none">
    <span>Pesan Cepat via WhatsApp</span>
  </div>

  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative flex items-center justify-center w-14 h-14 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg transition-transform hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-emerald-600"
    aria-label="Pesan via WhatsApp Jajanan Nusantara"
  >
    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.449.741.964 1.2.662.59 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.981-1.306A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
    </svg>
  </a>
</aside>
